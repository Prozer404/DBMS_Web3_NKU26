# =============================================================================
# Web3 数据库连接 — 复制本文件为 .env 后填写（.env 勿提交到 Git）
# =============================================================================

# ----- 方式 A：分项配置（与 db_manager.py、config.py 一致，推荐） -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=Web3

# ----- 方式 B：单一连接串（适合 SQLAlchemy；密码含特殊字符请 URL 编码） -----
# 若同时配置了上面的 MYSQL_DATABASE 等，以分项为准，本行可被忽略。
# DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/Web3?charset=utf8mb4

# ----- 管理后台（admin_server.py）-----
# 留空则 API 不校验密钥（仅本机演示）；设置后浏览器需在页面保存相同密钥。
ADMIN_API_KEY=

# 用户端 JWT 签名密钥（生产务必改为随机长字符串）
JWT_SECRET=dev-jwt-secret-change-in-production
